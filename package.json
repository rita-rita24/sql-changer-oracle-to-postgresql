{
  "name": "sql-changer-oracle-to-postgresql",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:e2e": "playwright test",
    "test:coverage": "node --experimental-test-coverage --test tests/unit/*.test.mjs",
    "test:mutation": "node scripts/mutation-smoke.mjs",
    "lint": "node scripts/lint-html.mjs",
    "typecheck": "npm run check:syntax",
    "build": "node scripts/build-check.mjs",
    "test:postgres": "node scripts/verify-postgres.mjs",
    "check:syntax": "node scripts/check-syntax.mjs",
    "test:databases": "node scripts/compare-databases.mjs",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "oracledb": "7.0.1",
    "pg": "8.23.0"
  }
}
